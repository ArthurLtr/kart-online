{
  "name": "@kart/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:stop": "node scripts/db-stop.mjs"
  },
  "dependencies": {
    "@kart/shared": "workspace:*",
    "@prisma/client": "^6",
    "colyseus": "^0.15.17",
    "embedded-postgres": "18.6.0-beta.19",
    "ioredis": "^5.11.1",
    "jose": "^6.2.17",
    "openskill": "^5.0.1"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.9.0",
    "ioredis-mock": "^8.13.1",
    "prisma": "^6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
