{
  "name": "kart-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @kart/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets": "node tools/assets/convert.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:stop": "pnpm --filter @kart/server db:stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "colyseus.js": "^0.15.26",
    "eslint": "^9.14.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
