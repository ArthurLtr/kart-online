# Copie para .env. Valores de desenvolvimento local (docker-compose.yml).
DATABASE_URL=postgresql://kart:kart_dev@localhost:5432/kart_online
REDIS_URL=redis://localhost:6379
SERVER_PORT=2567
# Sem REDIS_URL a fila de matchmaking fica na memória do servidor.
# Obrigatório em produção: segredo que assina as sessões.
AUTH_SECRET=troque-este-valor
# Liga a rota POST /api/admin/grant (cabeçalho x-admin-key).
ADMIN_KEY=
SEASON_NAME=Temporada 1
SEASON_DAYS=90
# Ranqueado: karts por partida e mínimo depois de 60 s de fila.
RANKED_PLAYERS=9
RANKED_MIN_PLAYERS=2

# Pareamento (habilidade = mu do OpenSkill x 100; jogador novo começa em 2500).
# Ranqueado: faixa inicial, quando começa a abrir, quanto abre a cada 10 s e espera máxima.
# MM_BASE_BAND=200
# MM_WIDEN_AFTER=30
# MM_WIDEN_STEP=150
# MM_UNCERTAINTY_BAND=0.35
# MM_SHORT_AFTER=60
# Casual: espera curta, os bots completam o grid no nível do grupo.
# CASUAL_PLAYERS=9
# MM_CASUAL_BASE_BAND=350
# MM_CASUAL_SHORT_AFTER=6
