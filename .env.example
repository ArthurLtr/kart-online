# Copie para .env. Valores de desenvolvimento local (docker-compose.yml).
DATABASE_URL=postgresql://kart:kart_dev@localhost:5432/kart_online
REDIS_URL=redis://localhost:6379
SERVER_PORT=2567
# Sem REDIS_URL a fila de matchmaking fica na memória do servidor.
# Obrigatório em produção: segredo que assina as sessões.
AUTH_SECRET=troque-este-valor
# Liga a rota POST /api/admin/grant (cabeçalho x-admin-key).
ADMIN_KEY=
SEASON_NAME=Temporada 1
SEASON_DAYS=90
# Ranqueado: karts por partida e mínimo depois de 60 s de fila.
RANKED_PLAYERS=9
RANKED_MIN_PLAYERS=2
